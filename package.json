{
  "name": "@sgtbeatdown/pi-tasks",
  "version": "0.1.6",
  "description": "Durable Pi agent delegation through the Wolfpack task gateway.",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./v1-compat-extension": "./src/v1-compat-extension.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almogdepaz/pi-tasks.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "agent",
    "tasks"
  ],
  "files": [
    "README.md",
    "src",
    "skills",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "@types/bun": "^1.3.14",
    "typebox": "^1.3.6",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "bun test",
    "task-metrics": "bun src/metrics-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "type": "module"
}
